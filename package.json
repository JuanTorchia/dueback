{
  "name": "dueback",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test && vitest run tests",
    "test:domain": "pnpm --filter @dueback/domain test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "evaluate": "tsx scripts/evaluation/run.ts",
    "test:deployed": "playwright test",
    "demo:reset": "tsx scripts/demo/reset.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.11",
    "eslint": "9.39.2",
    "genkit": "1.41.0",
    "prettier": "3.8.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "4.1.10"
  }
}
